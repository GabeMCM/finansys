{
  "tasks": {
    "dev": "deno run -A --unstable-kv npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A --unstable-kv npm:vite preview",
    "start": "deno run -A --unstable-kv server.ts",
    "test": "deno test -A --unstable-kv",
    "check": "deno check src/main.tsx"
  },
  "deploy": {
    "runtimeMode": "dynamic",
    "entrypoint": "server.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"]
  },
  "imports": {
    "dexie": "npm:dexie@^4.4.6",
    "vite": "npm:vite@^6.3.0",
    "@preact/preset-vite": "npm:@preact/preset-vite@^2.10.0",
    "preact": "npm:preact@^10.26.0",
    "preact/": "npm:/preact@^10.26.0/",
    "@preact/signals": "npm:@preact/signals@^2.0.0"
  }
}
